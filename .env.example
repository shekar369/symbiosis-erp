# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# Application
PROJECT_NAME=HR Payroll System - Symbiosiss
API_V1_STR=/api/v1

# Database
# For SQLite (development):
DATABASE_URL=sqlite:///test.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/hr_payroll

# Security
# Generate secure key with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5174","http://localhost:5173","http://localhost:8000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".xlsx", ".xls", ".csv"]
UPLOAD_DIR=uploads

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=HR Payroll System

# Logging
LOG_LEVEL=INFO
